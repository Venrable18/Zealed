 impl<P: consensus::Parameters> MemoryWalletDb<P> {
+    /// Every shielded note `account` has received, in public types: the transaction, the output
+    /// index within its pool, the height it was mined at (if it is), the note and its memo. (Added for Zealed, which lists received
+    /// memos; the tables themselves are private to this crate.)
+    pub fn received_notes_of(
+        &self,
+        account: AccountId,
+    ) -> Vec<(
+        TxId,
+        u32,
+        Option<BlockHeight>,
+        zcash_client_backend::wallet::Note,
+        zcash_protocol::memo::Memo,
+    )> {
+        self.received_notes
+            .0
+            .iter()
+            .filter(|note| note.account_id == account)
+            .map(|note| {
+                (
+                    note.txid,
+                    note.output_index,
+                    self.tx_table
+                        .get(&note.txid)
+                        .and_then(|entry| entry.mined_height()),
+                    note.note.clone(),
+                    note.memo.clone(),
+                )
+            })
+            .collect()
+    }
+
